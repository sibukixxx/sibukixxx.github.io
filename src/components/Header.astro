---
import ThemeToggle from './ThemeToggle.astro';
import { getLocale, t, getLocalizedPath, stripLocalePrefix } from '../i18n/utils';
import { locales, localeLabels, type Locale } from '../i18n/translations';

interface Props {
  showLanguageSwitcher?: boolean;
}

const { showLanguageSwitcher = true } = Astro.props;
const locale = getLocale(Astro.currentLocale);

interface NavItem {
  path: string;
  key?: string;
  label?: string;
  localized?: boolean;
  activePath?: string;
}

const navItems: NavItem[] = [
  { path: '/', key: 'nav.home' },
  { path: '/blog', key: 'nav.blog' },
  { path: '/en/oss', label: 'OSS Radar', localized: false, activePath: '/oss' },
  { path: '/projects', key: 'nav.projects' },
  { path: '/about', key: 'nav.about', localized: false },
  { path: '/contact', key: 'nav.contact', localized: false },
];

const currentPath = Astro.url.pathname;
const basePath = stripLocalePrefix(currentPath);
---

<header class="sticky top-0 z-50 border-b border-gray-200 bg-white/80 backdrop-blur-md dark:border-gray-700 dark:bg-gray-900/80">
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
    <a href={getLocalizedPath(locale, '/')} class="text-xl font-bold text-primary-600 dark:text-primary-400">
      sibukixxx
    </a>
    <div class="flex items-center gap-4">
      <ul class="flex items-center gap-6">
        {navItems.map(({ path, key, label, localized = true, activePath }) => {
          const href = localized ? getLocalizedPath(locale, path) : path;
          const matchPath = activePath ?? path;
          const isActive = basePath === matchPath || (matchPath !== '/' && basePath.startsWith(matchPath));
          return (
            <li>
              <a
                href={href}
                class:list={[
                  'text-sm font-medium transition-colors hover:text-primary-600 dark:hover:text-primary-400',
                  isActive
                    ? 'text-primary-600 dark:text-primary-400'
                    : 'text-gray-600 dark:text-gray-400',
                ]}
              >
                {label ?? (key ? t(locale, key) : '')}
              </a>
            </li>
          );
        })}
      </ul>
      <div class="flex items-center gap-2">
        <form action="/search/" method="get" role="search" class="relative hidden xl:block">
          <label for="header-search" class="sr-only">Search Blog and OSS Radar</label>
          <svg class="pointer-events-none absolute left-2.5 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="7" stroke-width="2" />
            <path d="m20 20-4-4" stroke-linecap="round" stroke-width="2" />
          </svg>
          <input
            id="header-search"
            name="q"
            type="search"
            value={currentPath === '/search/' || currentPath === '/search' ? Astro.url.searchParams.get('q') ?? '' : ''}
            placeholder="Search..."
            autocomplete="off"
            class="w-36 rounded-md border border-gray-300 bg-white py-1.5 pr-3 pl-8 text-sm text-gray-900 outline-none transition-colors placeholder:text-gray-400 focus:border-primary-500 focus:w-52 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100 dark:placeholder:text-gray-500"
          />
        </form>
        <a
          href="/search/"
          class="rounded-lg p-2 text-gray-500 hover:bg-gray-100 hover:text-gray-900 xl:hidden dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-gray-100"
          aria-label="Search Blog and OSS Radar"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="7" stroke-width="2" />
            <path d="m20 20-4-4" stroke-linecap="round" stroke-width="2" />
          </svg>
        </a>
        <ThemeToggle />
        {showLanguageSwitcher && <div class="relative">
          <button
            id="lang-toggle"
            class="flex items-center gap-1 rounded-md border border-gray-300 px-2 py-1 text-xs font-medium text-gray-600 transition-colors hover:border-gray-400 hover:text-gray-900 dark:border-gray-600 dark:text-gray-400 dark:hover:border-gray-500 dark:hover:text-gray-200"
            aria-label="Change language"
            aria-expanded="false"
          >
            {localeLabels[locale]}
            <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <ul
            id="lang-menu"
            class="absolute right-0 top-full mt-1 hidden min-w-[120px] rounded-md border border-gray-200 bg-white py-1 shadow-lg dark:border-gray-700 dark:bg-gray-800"
          >
            {locales.map((loc) => (
              <li>
                <a
                  href={getLocalizedPath(loc as Locale, basePath)}
                  class:list={[
                    'block px-3 py-1.5 text-xs transition-colors hover:bg-gray-100 dark:hover:bg-gray-700',
                    loc === locale
                      ? 'font-semibold text-primary-600 dark:text-primary-400'
                      : 'text-gray-700 dark:text-gray-300',
                  ]}
                >
                  {localeLabels[loc as Locale]}
                </a>
              </li>
            ))}
          </ul>
        </div>}
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('lang-toggle');
  const menu = document.getElementById('lang-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden');
    });
    document.addEventListener('click', (e) => {
      if (!toggle.contains(e.target as Node) && !menu.contains(e.target as Node)) {
        toggle.setAttribute('aria-expanded', 'false');
        menu.classList.add('hidden');
      }
    });
  }
</script>
