---
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { getCollection } from 'astro:content';
import { getDateLocale, getLocale, getLocalizedPath, t } from '../../i18n/utils';

const locale = getLocale(Astro.currentLocale);

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatDate = (date: Date) =>
  date.toLocaleDateString(getDateLocale(locale), {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---

<Base title={`${t(locale, 'blog.title')} | sibukixxx`} description={t(locale, 'blog.description')}>
  <Header />

  <main class="py-12">
    <div class="mx-auto max-w-5xl px-4">
      <header class="mb-12 text-center">
        <h1 class="mb-4 text-4xl font-bold tracking-tight text-gray-900 dark:text-gray-100">
          {t(locale, 'blog.title')}
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-400">
          {t(locale, 'blog.description')}
        </p>
      </header>

      <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800/50">
        {sortedPosts.map((post) => (
          <a
            href={getLocalizedPath(locale, `/blog/${post.id}`)}
            class="group grid grid-cols-1 gap-2 border-b border-gray-200 px-6 py-6 transition-all last:border-b-0 hover:bg-primary-50/70 sm:grid-cols-[10rem_1fr_auto] sm:items-center sm:gap-6 dark:border-gray-700 dark:hover:bg-primary-950/30"
          >
            <time
              datetime={post.data.pubDate.toISOString()}
              class="font-mono text-sm font-medium tracking-wide text-gray-500 dark:text-gray-400"
            >
              {formatDate(post.data.pubDate)}
            </time>
            <span class="text-lg font-semibold leading-snug text-gray-900 transition-colors group-hover:text-primary-600 sm:text-xl dark:text-gray-100 dark:group-hover:text-primary-400">
              {post.data.title}
            </span>
            <span class="hidden text-2xl text-gray-300 transition-all group-hover:translate-x-1 group-hover:text-primary-500 sm:block dark:text-gray-600" aria-hidden="true">
              →
            </span>
          </a>
        ))}
      </div>

      {sortedPosts.length === 0 && (
        <div class="rounded-xl border border-gray-200 bg-white p-12 text-center dark:border-gray-700 dark:bg-gray-800">
          <p class="text-gray-500 dark:text-gray-400">
            {t(locale, 'blog.empty')}
          </p>
        </div>
      )}
    </div>
  </main>

  <Footer />
</Base>
