---
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { getCollection } from 'astro:content';
import { getLocale, getLocalizedPath, t } from '../../i18n/utils';

const locale = getLocale(Astro.currentLocale);

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base title={`${t(locale, 'blog.title')} | sibukixxx`} description={t(locale, 'blog.description')}>
  <Header />

  <main class="py-12">
    <div class="mx-auto max-w-5xl px-4">
      <header class="mb-12 text-center">
        <h1 class="mb-4 text-4xl font-bold tracking-tight text-gray-900 dark:text-gray-100">
          {t(locale, 'blog.title')}
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-400">
          {t(locale, 'blog.description')}
        </p>
      </header>

      <div class="divide-y divide-gray-200 border-y border-gray-200 dark:divide-gray-700 dark:border-gray-700">
        {sortedPosts.map((post) => (
          <a
            href={getLocalizedPath(locale, `/blog/${post.id}`)}
            class="block py-5 text-xl font-semibold text-gray-900 transition-colors hover:text-primary-600 dark:text-gray-100 dark:hover:text-primary-400"
          >
            {post.data.title}
          </a>
        ))}
      </div>

      {sortedPosts.length === 0 && (
        <div class="rounded-xl border border-gray-200 bg-white p-12 text-center dark:border-gray-700 dark:bg-gray-800">
          <p class="text-gray-500 dark:text-gray-400">
            {t(locale, 'blog.empty')}
          </p>
        </div>
      )}
    </div>
  </main>

  <Footer />
</Base>
