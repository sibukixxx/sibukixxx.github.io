---
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import BlogCard from '../BlogCard.astro';
import ProjectCard from '../ProjectCard.astro';
import { getCollection } from 'astro:content';
import { getLocale, t, getLocalizedPath } from '../../i18n/utils';

const locale = getLocale(Astro.currentLocale);

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const allProjects = await getCollection('projects');
const featuredProjects = allProjects.slice(0, 3);
---

<Base title="sibukixxx | Blog & Portfolio">
  <Header />

  <main>
    <!-- Recent Posts Section -->
    <section class="py-16">
      <div class="mx-auto max-w-5xl px-4">
        <div class="mb-8 flex items-center justify-between">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
            {t(locale, 'home.recentPosts')}
          </h2>
          <a
            href={getLocalizedPath(locale, '/blog')}
            class="text-sm font-medium text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300"
          >
            {t(locale, 'home.viewAll')}
          </a>
        </div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {recentPosts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              slug={post.id}
              tags={post.data.tags}
            />
          ))}
        </div>
        {recentPosts.length === 0 && (
          <p class="text-center text-gray-500 dark:text-gray-400">
            {t(locale, 'home.noPosts')}
          </p>
        )}
      </div>
    </section>

    <!-- Projects Section -->
    <section class="bg-gray-100 py-16 dark:bg-gray-800">
      <div class="mx-auto max-w-5xl px-4">
        <div class="mb-8 flex items-center justify-between">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
            {t(locale, 'home.projects')}
          </h2>
          <a
            href={getLocalizedPath(locale, '/projects')}
            class="text-sm font-medium text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300"
          >
            {t(locale, 'home.viewAll')}
          </a>
        </div>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {featuredProjects.map((project) => (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              url={project.data.url}
              github={project.data.github}
              tech={project.data.tech}
            />
          ))}
        </div>
        {featuredProjects.length === 0 && (
          <p class="text-center text-gray-500 dark:text-gray-400">
            {t(locale, 'home.noProjects')}
          </p>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Base>
