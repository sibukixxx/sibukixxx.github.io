---
import Base from '../../layouts/Base.astro';

const title = 'Yuichi Takada - Senior Software Engineer / AI Coding Expert';
const description =
  'Yuichi Takada - Senior Software Engineer with 8+ years across fintech, security, healthcare, and generative AI. TypeScript, Go, Next.js, cloud architecture, LLM evaluation, and AI-assisted development.';
---

<Base title={title} description={description} lang="en">
  <main class="portfolio-page">
    <p class="lang-switch"><a href="/portfolio">日本語版 →</a></p>

    <header class="portfolio-hero">
      <h1>Yuichi Takada</h1>
      <p class="portfolio-title">Senior Software Engineer · AI Coding Expert</p>
      <p class="portfolio-tagline">
        8+ years shipping production systems in fintech, security, healthcare, and generative AI
        - now applying that craft to LLM evaluation, prompt engineering, and AI-assisted development.
      </p>
      <div class="portfolio-contact">
        <span>Tokyo, Japan (Remote-friendly, JST)</span>
        <a href="mailto:takada@techvit.me">takada@techvit.me</a>
        <a href="https://github.com/sibukixxx" target="_blank" rel="noopener">github.com/sibukixxx</a>
      </div>
    </header>

    <section>
      <h2>Summary</h2>
      <p>
        Senior full-stack engineer and independent contractor with 8+ years architecting and
        shipping production systems across fintech, cybersecurity, healthcare, retail, and
        generative AI. Trusted to own delivery end-to-end: architecture, backend, frontend,
        testing, and documentation inside teams ranging from 3 to 574 people, including as
        Tech Lead and Scrum Master on a full legacy-to-modern system renewal. Deep, current
        hands-on experience with TypeScript, Go, Next.js, Node.js, and REST API design, deployed
        on AWS, Azure, and GCP. Now focused on LLM evaluation, prompt engineering, and
        AI-assisted software development, paired with native Japanese and business-level English
        for cross-border teams and Japanese-language technical review.
      </p>
    </section>

    <section>
      <h2>Highlights</h2>
      <ul class="highlight-list">
        <li><strong>Currently</strong> building a production eKYC identity verification service in TypeScript and Go, using Claude-powered AI-assisted development to move faster without sacrificing quality.</li>
        <li><strong>Full-stack owner</strong> of a generative AI application for a major securities firm, from Azure infrastructure to shipped UI.</li>
        <li><strong>Tech Lead &amp; Scrum Master</strong> on a 59-person organization's system renewal, running legacy maintenance and a ground-up Go rebuild in parallel.</li>
        <li><strong>Cross-border delivery experience</strong>, partnering directly with an India-based product manager on a live production product.</li>
        <li><strong>8 consistent years</strong> as an independent contractor, with repeat engagements across fintech, security, healthcare, retail, and manufacturing/IoT clients.</li>
      </ul>
    </section>

    <section>
      <h2>Skills</h2>
      <dl class="skills-grid">
        <dt>Languages</dt>
        <dd>
          <span class="chip">TypeScript</span><span class="chip">JavaScript</span>
          <span class="chip">Go</span><span class="chip">Python</span>
          <span class="chip">PHP</span><span class="chip">Rust</span>
          <span class="chip">Shell Script</span>
        </dd>
        <dt>Frameworks</dt>
        <dd>
          <span class="chip">Next.js</span><span class="chip">Preact</span>
          <span class="chip">React</span><span class="chip">Vue.js</span>
          <span class="chip">Node.js</span><span class="chip">NestJS</span>
          <span class="chip">Laravel</span><span class="chip">FastAPI</span>
          <span class="chip">Flutter</span>
        </dd>
        <dt>Data &amp; Infra</dt>
        <dd>
          <span class="chip">PostgreSQL</span><span class="chip">MySQL</span>
          <span class="chip">Firebase</span><span class="chip">CosmosDB</span>
          <span class="chip">AWS</span><span class="chip">GCP</span>
          <span class="chip">Azure</span><span class="chip">Docker</span>
          <span class="chip">ECS</span><span class="chip">Cloud Architecture</span>
        </dd>
        <dt>AI &amp; Language</dt>
        <dd>
          <span class="chip">LLM Evaluation</span><span class="chip">Prompt Engineering</span>
          <span class="chip">Claude / AI-Assisted Development</span>
          <span class="chip">Japanese Localization</span><span class="chip">Japanese (Native)</span>
          <span class="chip">English (Business)</span>
        </dd>
        <dt>Practices</dt>
        <dd>
          <span class="chip">REST API Design</span><span class="chip">Scrum / Sprint</span>
          <span class="chip">Tech Lead</span><span class="chip">Code Review</span>
          <span class="chip">Unit &amp; Integration Testing</span>
        </dd>
      </dl>
    </section>

    <section>
      <h2>Experience</h2>

      <article class="job">
        <div class="job-head">
          <h3>Full-Stack Engineer - eKYC Service Development</h3>
          <span>Jul 2025 - Present</span>
        </div>
        <p class="job-meta">FinTech / Identity Verification · Independent Contractor</p>
        <ul>
          <li>Architecting and building a production eKYC identity verification service in TypeScript and Go, at the same scale and technical bar as the enterprise generative AI engagement below.</li>
          <li>Pioneering Claude-powered AI-assisted development workflows on the team, accelerating coding, review, and documentation without cutting quality.</li>
        </ul>
        <div class="stack"><span class="chip">TypeScript</span><span class="chip">Go</span><span class="chip">Claude / AI-Assisted Development</span></div>
      </article>

      <article class="job">
        <div class="job-head">
          <h3>Full-Stack Engineer - Generative AI Web Application for a Major Securities Firm</h3>
          <span>Apr 2024 - Jun 2025</span>
        </div>
        <p class="job-meta">AI / FinTech · Independent Contractor · Org ~574, Team of 5</p>
        <ul>
          <li>Owned full-stack delivery of a generative AI video creation application, from Azure infrastructure design to shipped frontend.</li>
          <li>Built backend services in Python/FastAPI and customer-facing features in TypeScript/Next.js for a major securities firm's production product.</li>
          <li>Drove test coverage and technical documentation standards for the feature set.</li>
        </ul>
        <div class="stack"><span class="chip">PHP / Laravel</span><span class="chip">TypeScript / Next.js</span><span class="chip">Python / FastAPI</span><span class="chip">Azure</span><span class="chip">PostgreSQL</span><span class="chip">CosmosDB</span></div>
      </article>

      <article class="job">
        <div class="job-head">
          <h3>Tech Lead / Scrum Master - Used-Car Sales Business System</h3>
          <span>Mar 2024 - Apr 2025</span>
        </div>
        <p class="job-meta">Manufacturing / Retail · Independent Contractor · Org ~59, Team of 6</p>
        <ul>
          <li>Led delivery as Tech Lead and Scrum Master, running Scrum/sprint process for a 6-person team.</li>
          <li>Directed a full legacy-to-Go system renewal in parallel with live maintenance of the existing platform with zero disruption to the business.</li>
          <li>Authored both the current and renewal system specifications and shipped Jest-tested frontend and backend features.</li>
        </ul>
        <div class="stack"><span class="chip">PHP / Laravel</span><span class="chip">TypeScript / Next.js</span><span class="chip">Go</span><span class="chip">MySQL</span><span class="chip">AWS / ECS</span></div>
      </article>

      <article class="job">
        <div class="job-head">
          <h3>Backend / Frontend Engineer - Cybersecurity Cloud Support Service</h3>
          <span>Aug 2024 - May 2025</span>
        </div>
        <p class="job-meta">Security · Independent Contractor · Org ~134, Team of 8</p>
        <ul>
          <li>Built backend and frontend features for a cybersecurity cloud support platform.</li>
          <li>Implemented unit and integration test coverage with Jest and Pytest.</li>
          <li>Produced ER-diagram-level technical documentation for the data model.</li>
        </ul>
        <div class="stack"><span class="chip">NestJS</span><span class="chip">Next.js / TypeScript</span><span class="chip">gRPC</span><span class="chip">Python</span><span class="chip">MySQL</span><span class="chip">AWS / ECS</span></div>
      </article>

      <article class="job">
        <div class="job-head">
          <h3>Full-Stack Engineer - IoT Application for Manufacturing</h3>
          <span>Oct 2023 - Jan 2024</span>
        </div>
        <p class="job-meta">Manufacturing · Independent Contractor · Org ~100, Team of 4</p>
        <ul>
          <li>Built backend and frontend for an IoT application serving manufacturing clients.</li>
          <li>Led Jest-based testing and authored ER and class-diagram documentation.</li>
        </ul>
        <div class="stack"><span class="chip">Rust</span><span class="chip">TypeScript</span><span class="chip">MySQL</span><span class="chip">Ubuntu</span></div>
      </article>

      <article class="job">
        <div class="job-head">
          <h3>Full-Stack Engineer - Drone Geographic Data Analysis Platform</h3>
          <span>Feb 2023 - Jul 2023</span>
        </div>
        <p class="job-meta">Construction / GeoTech · Independent Contractor · Org ~20, Team of 8</p>
        <ul>
          <li>Owned basic and detailed design through backend and frontend implementation.</li>
          <li>Delivered testing and technical documentation for a drone-based geo-data analysis service.</li>
        </ul>
        <div class="stack"><span class="chip">Python / ECS Task</span><span class="chip">Rust</span><span class="chip">PHP / Laravel</span><span class="chip">MySQL</span><span class="chip">AWS</span></div>
      </article>

      <article class="job">
        <div class="job-head">
          <h3>Full-Stack Engineer - Cryptocurrency Media Site &amp; Admin Console</h3>
          <span>Jan 2021 - Nov 2023</span>
        </div>
        <p class="job-meta">Media · Independent Contractor · Org ~10, Team of 4</p>
        <ul>
          <li>Designed and built a cryptocurrency media site and its admin console end-to-end.</li>
          <li>Delivered backend and frontend features, testing, and documentation.</li>
          <li>Collaborated directly with a product manager based in India in a cross-border team setting.</li>
        </ul>
        <div class="stack"><span class="chip">React / Next.js / Jest</span><span class="chip">TypeScript</span><span class="chip">Node.js</span><span class="chip">Python</span><span class="chip">Rust</span><span class="chip">Firebase</span><span class="chip">GCP</span></div>
      </article>

      <article class="job">
        <div class="job-head">
          <h3>Full-Stack Engineer - Recipe Management System for a Restaurant Company</h3>
          <span>Jul 2021 - Jan 2023</span>
        </div>
        <p class="job-meta">Food &amp; Beverage · Independent Contractor · Org ~30, Team of 5</p>
        <ul>
          <li>Owned basic/detailed design and backend implementation for a recipe-management system.</li>
          <li>Delivered testing and documentation across a mobile Flutter and web Next.js surface.</li>
        </ul>
        <div class="stack"><span class="chip">Dart / Flutter</span><span class="chip">React / Next.js / Jest / Cypress</span><span class="chip">TypeScript</span><span class="chip">Python</span><span class="chip">Firebase</span><span class="chip">GCP</span></div>
      </article>

      <article class="job">
        <div class="job-head">
          <h3>Full-Stack Engineer - Diabetes Patient Portal</h3>
          <span>Jul 2020 - Aug 2021</span>
        </div>
        <p class="job-meta">Healthcare / Media · Independent Contractor · Org ~20, Team of 4</p>
        <ul>
          <li>Owned basic/detailed design and implementation for a patient-facing portal and CMS backend.</li>
          <li>Delivered frontend, backend, and test coverage for the platform.</li>
        </ul>
        <div class="stack"><span class="chip">PHP / Laravel</span><span class="chip">Go</span><span class="chip">Vue.js</span><span class="chip">MySQL</span><span class="chip">AWS</span></div>
      </article>

      <article class="job">
        <div class="job-head">
          <h3>Engineer - Load-Testing Service &amp; Tooling</h3>
          <span>Sep 2020 - Jun 2021</span>
        </div>
        <p class="job-meta">Information Services · Independent Contractor · Org ~20, Team of 3</p>
        <ul>
          <li>Designed and built internal tooling for client-facing load-testing engagements.</li>
          <li>Ran load tests, produced client-facing reports, and handled test coordination.</li>
        </ul>
        <div class="stack"><span class="chip">JMeter</span><span class="chip">Python</span></div>
      </article>

      <article class="job">
        <div class="job-head">
          <h3>Full-Stack Engineer - Product Platform System for a Supermarket Chain</h3>
          <span>Apr 2017 - Aug 2020</span>
        </div>
        <p class="job-meta">Food Retail · Independent Contractor · Org ~200, Team of 5</p>
        <ul>
          <li>Delivered frontend and backend features for a nationwide supermarket's product platform.</li>
          <li>Owned test coverage and designed the infrastructure architecture for the system.</li>
        </ul>
        <div class="stack"><span class="chip">PHP / Laravel</span><span class="chip">MySQL</span><span class="chip">AWS</span></div>
      </article>
    </section>

    <section>
      <h2>Years of Experience by Technology</h2>
      <dl class="skills-grid">
        <dt>Languages</dt>
        <dd>JavaScript 7y · PHP 5y · ShellScript 5y · TypeScript 4.5y · Python 4y · Go 2y · Rust 2y</dd>
        <dt>Frameworks</dt>
        <dd>Vue.js 5y · Laravel 5y · React 3y · Flutter 2y</dd>
        <dt>Databases</dt>
        <dd>MySQL 8y · PostgreSQL 5y · Firebase 2y</dd>
        <dt>Cloud / Infra</dt>
        <dd>AWS 6y · GCP 6y</dd>
        <dt>Other</dt>
        <dd>Upstream requirements &amp; spec design 3y · Product management 1y</dd>
      </dl>
    </section>

    <section>
      <h2>Education</h2>
      <p>Senshu University - B.A.</p>
    </section>

    <footer>
      Resume last updated August 2026 · <a href="mailto:takada@techvit.me">takada@techvit.me</a>
    </footer>
  </main>
</Base>

<style>
  :global(body) {
    background: #ffffff;
    color: #1b1f23;
  }

  .portfolio-page {
    --ink: #1b1f23;
    --sub: #5b6470;
    --line: #e2e5e9;
    --accent: #1f5fbf;
    --chip-bg: #eef3fb;
    --chip-ink: #1f5fbf;
    max-width: 820px;
    margin: 0 auto;
    padding: 56px 24px 80px;
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    font-size: 16px;
    line-height: 1.55;
  }

  .lang-switch {
    margin: 0 0 20px;
    text-align: right;
    font-size: 0.85rem;
  }

  .lang-switch a {
    color: var(--sub);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .lang-switch a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .portfolio-hero {
    margin-bottom: 36px;
  }

  .portfolio-hero h1 {
    margin: 0 0 4px;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: 0;
  }

  .portfolio-title {
    margin: 0 0 14px;
    color: var(--accent);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .portfolio-tagline {
    max-width: 640px;
    margin: 0 0 16px;
    color: #3a4249;
    font-size: 0.97rem;
  }

  .portfolio-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    color: var(--sub);
    font-size: 0.92rem;
  }

  .portfolio-contact a,
  footer a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .portfolio-contact a:hover,
  footer a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  section {
    margin-bottom: 34px;
  }

  h2 {
    margin: 0 0 18px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
    color: var(--sub);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  section > p {
    margin: 0;
    color: #33393f;
  }

  .highlight-list {
    margin: 0;
    padding-left: 20px;
  }

  .highlight-list li {
    margin-bottom: 8px;
    font-size: 0.95rem;
  }

  .highlight-list strong {
    color: var(--accent);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 10px 14px;
    font-size: 0.93rem;
  }

  .skills-grid dt {
    color: var(--sub);
    font-weight: 600;
  }

  .skills-grid dd {
    margin: 0;
  }

  .chip {
    display: inline-block;
    margin: 0 6px 6px 0;
    border-radius: 999px;
    background: var(--chip-bg);
    color: var(--chip-ink);
    padding: 2px 9px;
    font-size: 0.82rem;
  }

  .job {
    margin-bottom: 26px;
    padding-bottom: 26px;
    border-bottom: 1px solid var(--line);
  }

  .job:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: 0;
  }

  .job-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    margin-bottom: 4px;
  }

  .job-head h3 {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 700;
  }

  .job-head span {
    color: var(--sub);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .job-meta {
    margin: 0 0 10px;
    color: var(--sub);
    font-size: 0.85rem;
  }

  .job ul {
    margin: 0 0 10px;
    padding-left: 20px;
  }

  .job li {
    margin-bottom: 4px;
    font-size: 0.94rem;
  }

  footer {
    margin-top: 48px;
    color: var(--sub);
    text-align: center;
    font-size: 0.8rem;
  }

  @media print {
    .portfolio-page {
      max-width: 100%;
      padding: 0;
      font-size: 12.5px;
    }

    .lang-switch {
      display: none;
    }

    .chip {
      background: none;
      color: var(--ink);
      padding: 0;
      margin-right: 8px;
    }

    a {
      color: inherit;
      text-decoration: none;
    }
  }

  @media (max-width: 520px) {
    .portfolio-page {
      padding: 40px 20px 64px;
    }

    .skills-grid {
      grid-template-columns: 1fr;
    }

    .skills-grid dt {
      margin-top: 8px;
    }
  }
</style>
