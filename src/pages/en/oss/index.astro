---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('oss', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---

<Base
  title="OSS Radar | Underrated open-source tools"
  description="Discover useful open-source tools before everyone else. Independent reviews, comparisons, and hidden gems from outside the usual OSS bubble."
  lang="en"
>
  <Header showLanguageSwitcher={false} />

  <main class="mx-auto max-w-5xl px-4 py-16">
    <header class="max-w-3xl pb-12">
      <p class="mb-4 font-mono text-sm font-semibold uppercase tracking-[0.18em] text-primary-600 dark:text-primary-400">
        OSS Radar
      </p>
      <h1 class="text-4xl font-bold leading-tight tracking-tight text-gray-950 sm:text-5xl dark:text-gray-50">
        Discover great open-source tools before everyone else.
      </h1>
      <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-400">
        Independent discoveries, practical comparisons, and overlooked developer tools from outside the usual information bubble.
      </p>
    </header>

    <section aria-labelledby="latest-discoveries">
      <div class="mb-5 flex items-end justify-between border-b border-gray-200 pb-4 dark:border-gray-700">
        <h2 id="latest-discoveries" class="text-xl font-semibold text-gray-900 dark:text-gray-100">
          Latest discoveries
        </h2>
        <span class="font-mono text-xs text-gray-500 dark:text-gray-500">
          {posts.length} {posts.length === 1 ? 'article' : 'articles'}
        </span>
      </div>

      <div class="divide-y divide-gray-200 dark:divide-gray-700">
        {posts.map((post) => (
          <article class="grid gap-3 py-7 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <time datetime={post.data.pubDate.toISOString()} class="font-mono text-sm text-gray-500 dark:text-gray-500">
              {formatDate(post.data.pubDate)}
            </time>
            <div>
              <h3>
                <a href={`/en/oss/${post.id}`} class="text-xl font-semibold text-gray-900 transition-colors hover:text-primary-600 dark:text-gray-100 dark:hover:text-primary-400">
                  {post.data.title}
                </a>
              </h3>
              <p class="mt-2 max-w-2xl leading-7 text-gray-600 dark:text-gray-400">
                {post.data.description}
              </p>
              <div class="mt-3 flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <span class="font-mono text-xs text-gray-500 dark:text-gray-500">#{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Base>
