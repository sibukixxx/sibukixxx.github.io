---
import BlogPost from '../../layouts/BlogPost.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);

  return allPosts.map((post) => {
    // Find related posts (same tags, excluding current post)
    const relatedPosts = allPosts
      .filter((p) => {
        if (p.id === post.id) return false;
        const commonTags = post.data.tags?.filter((tag) =>
          p.data.tags?.includes(tag)
        );
        return commonTags && commonTags.length > 0;
      })
      .sort((a, b) => {
        // Sort by number of common tags (descending)
        const aCommon = a.data.tags?.filter((tag) =>
          post.data.tags?.includes(tag)
        ).length || 0;
        const bCommon = b.data.tags?.filter((tag) =>
          post.data.tags?.includes(tag)
        ).length || 0;
        if (bCommon !== aCommon) return bCommon - aCommon;
        // Then by date (newest first)
        return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
      })
      .slice(0, 3);

    return {
      params: { slug: post.id },
      props: { post, relatedPosts },
    };
  });
}

interface Props {
  post: CollectionEntry<'blog'>;
  relatedPosts: CollectionEntry<'blog'>[];
}

const { post, relatedPosts } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  tags={post.data.tags}
  headings={headings}
  slug={post.id}
  relatedPosts={relatedPosts}
>
  <Content />
</BlogPost>
